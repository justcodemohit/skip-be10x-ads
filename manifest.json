{
  "manifest_version": 3,
  "name": "YT Ad Speeder",
  "version": "1.0",
  "description": "Speeds up and mutes YouTube ads that match keywords you choose.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "YT Ad Speeder" }
}
